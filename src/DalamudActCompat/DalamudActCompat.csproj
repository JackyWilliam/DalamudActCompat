<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <AssemblyName>DalamudActCompat</AssemblyName>
    <RootNamespace>DalamudActCompat</RootNamespace>
    <Version>0.3.10.4</Version>
    <AssemblyVersion>0.3.10.4</AssemblyVersion>
    <Name>Dalamud ACT Compat</Name>
    <Author>raynording</Author>
    <Punchline>In-game ACT-compatible parsing platform foundation.</Punchline>
    <Description>Dalamud-side UI, storage, parser abstraction, and compatibility-host bridge for an ACT-compatible FFXIV parsing platform.</Description>
    <RepoUrl>https://github.com/JackyWilliam/DalamudActCompat</RepoUrl>
    <MinimumDalamudVersion>15.0.0</MinimumDalamudVersion>
    <CanUnloadAsync>true</CanUnloadAsync>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CompatibilityHostTargetFramework>net10.0-windows10.0.17763.0</CompatibilityHostTargetFramework>
    <SystemSpeechRuntimeImplementation>..\DalamudActCompat.Host\bin\$(Configuration)\$(CompatibilityHostTargetFramework)\runtimes\win\lib\net10.0\System.Speech.dll</SystemSpeechRuntimeImplementation>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../DalamudActCompat.Host/DalamudActCompat.Host.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../DalamudActCompat.Protocol/DalamudActCompat.Protocol.csproj" />
    <ProjectReference Include="../DalamudActCompat.ActRuntime/DalamudActCompat.ActRuntime.csproj" />
    <PackageReference Include="SharpCompress" Version="0.50.1" />
    <Content Include="../../vendor/IINACT/LICENSE" Link="LICENSES/IINACT-GPL-3.0.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../vendor/IINACT/OverlayPlugin.Core/LICENSE.txt" Link="LICENSES/OverlayPlugin.Core-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../vendor/IINACT/OverlayPlugin.Common/LICENSE.txt" Link="LICENSES/OverlayPlugin.Common-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../vendor/IINACT/machina/LICENSE.md" Link="LICENSES/Machina-LICENSE.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../vendor/ThirdParty/dnlib-LICENSE.txt" Link="LICENSES/dnlib-MIT.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../vendor/ThirdParty/WindowsCommunityToolkit-LICENSE.md" Link="LICENSES/WindowsCommunityToolkit-MIT.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../vendor/BundledActPlugins/**/*"
             Link="BundledActPlugins/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../vendor/BundledCactbot/**/*"
             Link="BundledCactbot/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../LICENSE.md" Link="LICENSE.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/**/*"
             Link="Assets/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyCompatibilityHost" BeforeTargets="DefaultDalamudPackagerDebug;DefaultDalamudPackagerRelease">
    <ItemGroup>
      <CompatibilityHostFiles Include="../DalamudActCompat.Host/bin/$(Configuration)/$(CompatibilityHostTargetFramework)/*.dll"
                              Exclude="../DalamudActCompat.Host/bin/$(Configuration)/$(CompatibilityHostTargetFramework)/System.Speech.dll" />
      <CompatibilityHostFiles Include="../DalamudActCompat.Host/bin/$(Configuration)/$(CompatibilityHostTargetFramework)/*.exe" />
      <CompatibilityHostFiles Include="../DalamudActCompat.Host/bin/$(Configuration)/$(CompatibilityHostTargetFramework)/*.json" />
      <CompatibilityHostFiles Include="$(SystemSpeechRuntimeImplementation)" />
    </ItemGroup>
    <MakeDir Directories="$(OutputPath)host" />
    <Copy SourceFiles="@(CompatibilityHostFiles)" DestinationFolder="$(OutputPath)host" SkipUnchangedFiles="true" />
    <ItemGroup Condition="'$(Configuration)' == 'Release'">
      <ReleaseDebugSymbols Include="$(OutputPath)**/*.pdb" />
    </ItemGroup>
    <Delete Files="@(ReleaseDebugSymbols)" Condition="'$(Configuration)' == 'Release'" />
  </Target>

</Project>
