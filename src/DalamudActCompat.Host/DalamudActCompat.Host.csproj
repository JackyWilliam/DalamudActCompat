<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>DalamudActCompat.Host</RootNamespace>
    <AssemblyName>DalamudActCompat.Host</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <NoWarn>$(NoWarn);NU1510;CS0436</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DalamudActCompat.Protocol\DalamudActCompat.Protocol.csproj" />
    <ProjectReference Include="..\..\vendor\IINACT\NotACT\NotACT.csproj" />
    <PackageReference Include="dnlib" Version="4.5.0" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Formats.Nrbf" Version="10.0.10" />
    <PackageReference Include="System.Resources.Extensions" Version="10.0.10" />
    <PackageReference Include="System.Speech" Version="10.0.0" />
    <Reference Include="FFXIV_ACT_Plugin">
      <HintPath>..\..\vendor\IINACT\external_dependencies\FFXIV_ACT_Plugin.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="FFXIV_ACT_Plugin.Common">
      <HintPath>..\..\vendor\IINACT\external_dependencies\FFXIV_ACT_Plugin.Common.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
