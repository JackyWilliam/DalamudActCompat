<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Verify the shipped parser's filtering behavior, including its live settings mediator. -->
    <Reference Include="FFXIV_ACT_Plugin.Config;FFXIV_ACT_Plugin.Common;FFXIV_ACT_Plugin.Logfile">
      <HintPath>../../vendor/IINACT/external_dependencies/%(Identity).dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="TerraFX.Interop.Windows">
      <HintPath>$(DalamudLibPath)TerraFX.Interop.Windows.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Content Include="Fixtures/PictoCleanupScopes.xml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures/PictoOnline*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures/U7bP1Drawings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Players download these two official packages on demand (FflogsUploadEngineFiles). The
         FFLogs upload smoke test checks the pinned hashes against the restored archives and runs
         the real V8 engine from them; nothing here reaches the plugin's own output. -->
    <PackageReference Include="Microsoft.ClearScript.V8.Native.win-x64" Version="7.5.0" ExcludeAssets="all" PrivateAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.ClearScript.V8.ICUData" Version="7.5.0" ExcludeAssets="all" PrivateAssets="all" GeneratePathProperty="true" />
    <Content Include="$(PkgMicrosoft_ClearScript_V8_Native_win-x64)\microsoft.clearscript.v8.native.win-x64.7.5.0.nupkg"
             Link="FflogsEngine/microsoft.clearscript.v8.native.win-x64.7.5.0.nupkg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(PkgMicrosoft_ClearScript_V8_ICUData)\microsoft.clearscript.v8.icudata.7.5.0.nupkg"
             Link="FflogsEngine/microsoft.clearscript.v8.icudata.7.5.0.nupkg" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="..\..\src\DalamudActCompat\DalamudActCompat.csproj" />
    <Reference Include="Dalamud">
      <HintPath>$(DalamudLibPath)Dalamud.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="FFXIVClientStructs">
      <HintPath>$(DalamudLibPath)FFXIVClientStructs.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="InteropGenerator.Runtime">
      <HintPath>$(DalamudLibPath)InteropGenerator.Runtime.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Mono.Cecil">
      <HintPath>$(DalamudLibPath)Mono.Cecil.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Lumina">
      <HintPath>$(DalamudLibPath)Lumina.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Dalamud.Bindings.ImGui">
      <HintPath>$(DalamudLibPath)Dalamud.Bindings.ImGui.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(DalamudLibPath)Newtonsoft.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
