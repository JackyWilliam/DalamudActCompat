    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DalamudActCompat.LegacyResourceSmokeTests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DalamudActCompat.ActRuntime\DalamudActCompat.ActRuntime.csproj" />
    <Reference Include="Mono.Cecil">
      <HintPath>$(DalamudLibPath)Mono.Cecil.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
