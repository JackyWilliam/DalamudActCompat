+        {
+            if (DactBridge.IsAvailable)
+            {
+                // DACT owns both non-blocking notification routes; never re-enter the
+                // upstream MessageBox fallback when neither route accepts a message.
+                _ = DactBridge.SendNotification(message, eventType.ToString());
+                return;
+            }
+
+            // Keep WinRT types out of the DACT entry method. The external Host can reject
+            // those types while JIT-compiling this method even when the bridge branch wins.
+            SendWindowsNativeToast(message);
+        }
