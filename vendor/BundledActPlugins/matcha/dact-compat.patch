diff --git a/Cafe.Matcha/Utils/DactBridge.cs b/Cafe.Matcha/Utils/DactBridge.cs
new file mode 100644
index 0000000..910a467
--- /dev/null
+++ b/Cafe.Matcha/Utils/DactBridge.cs
@@ -0,0 +1,114 @@
+// DACT compatibility bridge. Outside DACT every operation preserves the
+// upstream implementation; inside DACT the dedicated Host supplies scoped
+// permission and notification methods through reflection.
+namespace Cafe.Matcha.Utils
+{
+    using System;
+    using System.Diagnostics;
+    using System.IO;
+    using System.Reflection;
+    using System.Runtime.ExceptionServices;
+
+    internal static class DactBridge
+    {
+        public const string ContractVersion = "2";
+
+        private static readonly Type BridgeType = Type.GetType(
+            "DalamudActCompat.Host.HostPluginBridge, DalamudActCompat.Host",
+            false);
+
+        public static bool IsAvailable => BridgeType != null;
+
+        public static string ReadAllText(string path)
+        {
+            if (!IsAvailable)
+            {
+                return File.ReadAllText(path);
+            }
+
+            return (string)Invoke("ReadMatchaTextFile", path);
+        }
+
+        public static void WriteAllText(string path, string contents)
+        {
+            if (!IsAvailable)
+            {
+                File.WriteAllText(path, contents);
+                return;
+            }
+
+            Invoke("WriteMatchaTextFile", path, contents);
+        }
+
+        public static string ReadUserTextFile(string path)
+        {
+            if (!IsAvailable)
+            {
+                return File.ReadAllText(path);
+            }
+
+            return (string)Invoke("ReadMatchaUserTextFile", path);
+        }
+
+        public static void WriteUserTextFile(string path, string contents)
+        {
+            if (!IsAvailable)
+            {
+                File.WriteAllText(path, contents);
+                return;
+            }
+
+            Invoke("WriteMatchaUserTextFile", path, contents);
+        }
+
+        public static Process StartProcess(ProcessStartInfo startInfo)
+        {
+            if (!IsAvailable)
+            {
+                return Process.Start(startInfo);
+            }
+
+            return (Process)Invoke("StartMatchaProcess", startInfo);
+        }
+
+        public static void Demand(string capability)
+        {
+            if (IsAvailable)
+            {
+                Invoke("DemandMatchaCapability", capability);
+            }
+        }
+
+        public static bool SendNotification(string message)
+        {
+            try
+            {
+                return IsAvailable && (bool)Invoke("SendMatchaNotification", message);
+            }
+            catch (Exception exception)
+            {
+                // Real-time alerts must not fall through to Matcha's blocking dialog;
+                // stderr is collected by the dedicated Host for later diagnostics.
+                Console.Error.WriteLine($"DACT notification delivery failed: {exception}");
+                return false;
+            }
+        }
+
+        private static object Invoke(string methodName, params object[] arguments)
+        {
+            var method = BridgeType.GetMethod(
+                methodName,
+                BindingFlags.Public | BindingFlags.Static)
+                ?? throw new MissingMethodException(BridgeType.FullName, methodName);
+            try
+            {
+                return method.Invoke(null, arguments);
+            }
+            catch (TargetInvocationException exception) when (exception.InnerException != null)
+            {
+                ExceptionDispatchInfo.Capture(exception.InnerException).Throw();
+                throw;
+            }
+        }
+    }
+}
